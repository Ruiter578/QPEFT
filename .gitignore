experiments_dev_push/
QPEFT_final_exps/

# Important note:
# Do NOT ignore the whole experiments/ directory by default.
# Keep experiment notes/config summaries under experiments/ if useful.
# Ignore generated subfolders inside experiments instead:
experiments/**/outputs/
experiments/**/runs/
experiments/**/checkpoints/
experiments/**/logs/

