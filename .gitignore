# VS Code:
# If you want to share recommended extensions/settings, do not ignore all .vscode/.
# Instead, ignore machine-specific files and selectively commit useful settings.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# JetBrains:
# Prefer putting .idea/ in your global gitignore unless your team wants to share it.
.idea/

# Spyder / Rope
.spyderproject
.spyproject
.ropeproject

