__pypackages__/

# ============================================================
# Python package managers / build tools
# ============================================================

# pipenv:
# Usually applications may commit Pipfile.lock for reproducibility.
# Uncomment only if you intentionally do not want to track it.
# Pipfile.lock

# uv:
# Usually applications may commit uv.lock for reproducibility.
# Uncomment only if you intentionally do not want to track it.
# uv.lock

# poetry:
# Usually applications may commit poetry.lock for reproducibility.
# Uncomment only if you intentionally do not want to track it.
# poetry.lock
# poetry.toml

# pdm:
# Usually applications may commit pdm.lock / pdm.toml for reproducibility.
# Uncomment only if you intentionally do not want to track them.
# pdm.lock
# pdm.toml
.pdm-python
.pdm-build/

# pixi:
# Usually applications may commit pixi.lock for reproducibility.
# Uncomment only if you intentionally do not want to track it.
# pixi.lock
.pixi/

