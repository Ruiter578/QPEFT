{
    "data_path": "./data/vtab-1k",
    "batch_size": 32,
    "optimizer": "AdamW",
    "lr": 0.001,
    "min_lr": 1e-07,
    "epochs": 100,
    "warmup_epochs": 20,
    "num_workers": 10,
    "weight_decay": 0.0001,
    "momentum": 0.9,
    "drop_path": 0.1,
    "val_interval": 10,
    "rounding": {
        "strategy": "drop_ste",
        "initial_drop_rate": 0.99,
        "adjust_from_grads": true,
        "drop_epc_ratio": 0.5,
        "outliers_drop_rate": 0.99,
        "final_drop_rate": 0.0
    },
    "w_bit": 3,
    "a_bit": 3,
    "w_scale_training": true,
    "a_scale_training": true,
    "w_channel_wise": true,
    "a_channel_wise": false,
    "w_signed": true,
    "a_signed": true,
    "epochs_reset_qparams": 1,
    "qconv_weight": {
        "channel_wise": true,
        "scale_training": false,
        "bit_width": 8
    },
    "qconv_act": {
        "channel_wise": true,
        "scale_training": false,
        "bit_width": 8
    },
    "scale_grad": true,
    "act_ema_decay": 0.9,
    "weight_ema_decay": 0.99,
    "weight_clip_percentile": 99.99,
    "act_clip_percentile_high": 99.99,
    "act_clip_percentile_low": 0.01,
    "post_gelu_quantize": {
        "type": "adaptive_log",
        "bit_width": 3,
        "act_clip_percentile_high": 99.99,
        "act_clip_percentile_low": 0.01,
        "signed": false,
        "channel_wise": false,
        "enable_adaptive_shift": true,
        "scale_training": true
    },
    "post_softmax_quantize": {
        "type": "adaptive_log",
        "bit_width": 3,
        "act_clip_percentile_high": 100.0,
        "act_clip_percentile_low": 0.0,
        "signed": false,
        "channel_wise": true,
        "enable_adaptive_shift": false,
        "scale_training": true
    },
    "lora_r": 2,
    "lora_apply_position": [
        "qkv",
        "fc1",
        "proj",
        "fc2"
    ],
    "model": "vitb16",
    "train_cfgs": "vtab",
    "quant_cfgs": "3bit",
    "lora_cfgs": "lora_2_qkv-fc1-proj-fc2",
    "dataset": "cifar",
    "device": "cuda",
    "amp": false,
    "print_freq": 10,
    "seed": 42,
    "log_root": "outputs_dev",
    "exp_name": "default",
    "save_ckpt": true,
    "eval_ckpt": null,
    "eval": false,
    "log_path": "outputs_dev/vitb16/T=vtab_Q=3bit_L=lora_2_qkv-fc1-proj-fc2/cifar/20260113211818_default",
    "tb_path": "outputs_dev/vitb16/T=vtab_Q=3bit_L=lora_2_qkv-fc1-proj-fc2/cifar/20260113211818_default/tensorboard",
    "inception": true
}